# Configuración de Base de Datos PostgreSQL
POSTGRES_DB=gestion_ganadera
POSTGRES_USER=ganadero
POSTGRES_PASSWORD=cambiar_esta_clave_local
DATABASE_URL=postgresql+psycopg://ganadero:cambiar_esta_clave_local@db:5432/gestion_ganadera

# Configuración de Seguridad y JWT
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# SMTP para recuperación de contraseña
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
